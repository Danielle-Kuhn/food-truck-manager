<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="painelPrincipal"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.food_truck.controller.PrincipalController"
            style="-fx-background-color: #f4f6f8;">

    <center>
        <VBox alignment="CENTER"
              spacing="9">

            <padding>
                <Insets top="20" right="40" bottom="20" left="40"/>
            </padding>

            <Label text="FOOD TRUCK MANAGER"
                   style="-fx-font-size: 30px; -fx-font-weight: bold; -fx-text-fill: #263238;"/>

            <Label text="Sistema de gerenciamento de pedidos e produtos"
                   style="-fx-font-size: 14px; -fx-text-fill: #607d8b;"/>

            <VBox spacing="9"
                  maxWidth="320">
                <Button text="Gerenciar Categorias"
                        onAction="#abrirCategorias"
                        maxWidth="Infinity"
                        style="-fx-background-color: #2e7d32; -fx-text-fill: white; -fx-font-size: 15px; -fx-padding: 8;"/>

                <Button text="Gerenciar Produtos"
                        onAction="#abrirProdutos"
                        maxWidth="Infinity"
                        style="-fx-background-color: #1565c0; -fx-text-fill: white; -fx-font-size: 15px; -fx-padding: 8;"/>

                <Button text="Gerenciar Clientes"
                        onAction="#abrirClientes"
                        maxWidth="Infinity"
                        style="-fx-background-color: #6a1b9a; -fx-text-fill: white; -fx-font-size: 15px; -fx-padding: 8;"/>

                <Button text="Pedidos"
                    onAction="#abrirPedidos"
                    maxWidth="Infinity"
                    prefHeight="42"
                    style="-fx-background-color: #1565c0; -fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: bold;"/>
                
                <Button text="Dashboard de vendas" onAction="#abrirDashboard" maxWidth="Infinity"
                        style="-fx-background-color: #00838f; -fx-text-fill: white; -fx-font-size: 15px; -fx-padding: 8;"/>
                <Button text="Relatórios e filtros" onAction="#abrirRelatorios" maxWidth="Infinity"
                        style="-fx-background-color: #455a64; -fx-text-fill: white; -fx-font-size: 15px; -fx-padding: 8;"/>
                <Button text="Controle de estoque" onAction="#abrirEstoque" maxWidth="Infinity"
                        style="-fx-background-color: #ef6c00; -fx-text-fill: white; -fx-font-size: 15px; -fx-padding: 8;"/>
                <Button text="Sair" onAction="#sair" maxWidth="Infinity"/>
            </VBox>

            <Label text="Food Truck Manager | Gestão simplificada"
                   style="-fx-font-size: 11px; -fx-text-fill: #78909c;"/>

        </VBox>
    </center>
</BorderPane>
