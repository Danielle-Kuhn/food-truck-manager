<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.food_truck.controller.CategoriaController"
            style="-fx-background-color: #f4f6f8;">

    <top>
        <VBox spacing="6"
            style="-fx-background-color: #263238;">

            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>
            <Label text="Gerenciamento de Categorias"
                   style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;"/>
            <Label text="Cadastre e organize as categorias dos produtos."
                   style="-fx-text-fill: #cfd8dc; -fx-font-size: 13px;"/>
            <Button text="Voltar ao menu"
                onAction="#voltarAoMenu"
                maxWidth="150"
                style="-fx-background-color: #546e7a; -fx-text-fill: white; -fx-font-weight: bold;"/>
        </VBox>
    </top>

    <center>
        <VBox spacing="15">

            <padding>
                <Insets top="25" right="25" bottom="25" left="25"/>
            </padding>

            <VBox spacing="8"
                  style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 18;">
                <Label text="Dados da categoria"
                       style="-fx-font-size: 17px; -fx-font-weight: bold;"/>

                <Label text="Nome"/>
                <TextField fx:id="txtNome"
                           promptText="Ex.: Bebidas, Lanches, Sobremesas"/>

                <Label text="Descrição"/>
                <TextField fx:id="txtDescricao"
                           promptText="Descreva a categoria"/>
                
                <HBox spacing="10">
                    <Button fx:id="btnSalvar"
                            text="Cadastrar"
                            onAction="#salvar"
                            style="-fx-background-color: #2e7d32; -fx-text-fill: white; -fx-font-weight: bold;"/>

                    <Button text="Limpar"
                            onAction="#limpar"/>

                    <Button text="Excluir selecionada"
                            onAction="#excluir"
                            style="-fx-background-color: #c62828; -fx-text-fill: white;"/>
                </HBox>
            </VBox>

            <Label text="Categorias cadastradas"
                   style="-fx-font-size: 17px; -fx-font-weight: bold;"/>

            <TableView fx:id="tabelaCategorias"
                       VBox.vgrow="ALWAYS">

                <columns>
                    <TableColumn fx:id="colunaId"
                                 text="Código"
                                 prefWidth="90"/>

                    <TableColumn fx:id="colunaNome"
                                 text="Nome"
                                 prefWidth="220"/>

                    <TableColumn fx:id="colunaDescricao"
                                 text="Descrição"
                                 prefWidth="400"/>
                </columns>

            </TableView>

        </VBox>
    </center>

</BorderPane>
