<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.food_truck.controller.RelatorioController"
            style="-fx-background-color: #f4f6f8;">
    <top><VBox spacing="8" style="-fx-background-color: #263238;"><padding><Insets top="16" right="20" bottom="16" left="20"/></padding>
        <Label text="Relatórios e filtros avançados" style="-fx-text-fill: white; -fx-font-size: 23px; -fx-font-weight: bold;"/>
        <Button text="Voltar ao menu" onAction="#voltarAoMenu" maxWidth="150"/>
    </VBox></top>
    <center><VBox spacing="12"><padding><Insets top="18" right="20" bottom="18" left="20"/></padding>
        <VBox spacing="8" style="-fx-background-color: white; -fx-padding: 14; -fx-background-radius: 8;">
            <Label text="Critérios de pesquisa" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
            <GridPane hgap="10" vgap="8">
                <Label text="Data inicial" GridPane.rowIndex="0" GridPane.columnIndex="0"/><DatePicker fx:id="dataInicio" promptText="Início" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <Label text="Data final" GridPane.rowIndex="0" GridPane.columnIndex="1"/><DatePicker fx:id="dataFim" promptText="Fim" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                <Label text="Cliente" GridPane.rowIndex="0" GridPane.columnIndex="2"/><TextField fx:id="txtCliente" promptText="Nome do cliente" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
                <Label text="Status" GridPane.rowIndex="0" GridPane.columnIndex="3"/><ComboBox fx:id="comboStatus" GridPane.rowIndex="1" GridPane.columnIndex="3" prefWidth="160"/>
            </GridPane>
            <HBox spacing="8"><Button text="Filtrar" onAction="#filtrar" style="-fx-background-color: #1565c0; -fx-text-fill: white;"/><Button text="Limpar" onAction="#limparFiltros"/><Button text="Exportar CSV" onAction="#exportarCsv" style="-fx-background-color: #2e7d32; -fx-text-fill: white;"/></HBox>
        </VBox>
        <Label fx:id="lblResumo" text="0 pedido(s)" style="-fx-font-weight: bold;"/>
        <TableView fx:id="tabela" VBox.vgrow="ALWAYS"><columns>
            <TableColumn fx:id="colId" text="Código" prefWidth="75"/><TableColumn fx:id="colCliente" text="Cliente" prefWidth="190"/>
            <TableColumn fx:id="colData" text="Data" prefWidth="170"/><TableColumn fx:id="colStatus" text="Status" prefWidth="150"/><TableColumn fx:id="colTotal" text="Total" prefWidth="130"/>
        </columns></TableView>
    </VBox></center>
</BorderPane>
